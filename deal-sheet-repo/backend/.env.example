# Local dev (matches docker-compose.yml) — safe as committed, no real secret in it.
DATABASE_URL=postgresql+psycopg://dealsheet:dealsheet@localhost:5433/dealsheet

# Production (Supabase) — put the REAL value in a git-ignored backend/.env, never here.
# Use the DIRECT connection (port 5432) for migrations, or the Session pooler if your
# network doesn't support IPv6 (see backend/README.md).
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# RentCast — free-tier key from rentcast.io. Put the REAL value in a git-ignored
# backend/.env, never here.
# RENTCAST_API_KEY=<your-real-key>
